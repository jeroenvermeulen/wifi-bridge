CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

CONFIG_ETH_USE_SPI_ETHERNET=y
CONFIG_ETH_SPI_ETHERNET_W5500=y

# More WiFi buffers: every frame is forwarded, nothing is consumed locally.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=96
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=64
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y
# Block-ack windows: at the default 6 an AMPDU carries at most 6 frames. 32
# is what Espressif's iperf example uses on the ESP32. Measured on
# esp32-w5500 (2026-10-26, 16x5 MB each way): 1969 vs 1913 KB/s down, 740 vs
# 690 KB/s up, at the cost of ~24 KB more internal RAM in use under load
# and bigger bursts into the wifi->eth queue.
CONFIG_ESP_WIFI_TX_BA_WIN=32
CONFIG_ESP_WIFI_RX_BA_WIN=32

# Per-task CPU use in the stats log (uxTaskGetSystemState).
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
